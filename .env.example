# Vorlage für die Datei .env – wird von run.py beim ersten Start automatisch
# mit zufälligen Schlüsseln angelegt. Die echte .env niemals weitergeben oder committen!

# Betriebsart: "lokal" (Testversion auf diesem Rechner) oder "server"
APP_ENV=lokal

# Datenbank: lokal SQLite, auf dem Server PostgreSQL, z. B.
# DATABASE_URL=postgresql+psycopg://benutzer:passwort@localhost:5432/buchhaltung
DATABASE_URL=sqlite:///data/app.db

# Zufälliger Schlüssel für Sitzungen/Tokens
SECRET_KEY=bitte-ersetzen

# Schlüssel für verschlüsselt gespeicherte Zugangsdaten (Fernet). Geht er verloren,
# lassen sich gespeicherte Passwörter (IMAP/SMTP) nicht mehr entschlüsseln.
ENCRYPTION_KEY=bitte-ersetzen

# Nur nötig, wenn die Ersteinrichtung NICHT von diesem Rechner (127.0.0.1) aus erfolgt
SETUP_TOKEN=

# Cookies nur über HTTPS senden (auf dem Server: true)
COOKIE_SECURE=false

# Hintergrund-Aufgaben (automatischer E-Mail-Abruf) im Programm mitlaufen lassen.
# Auf dem Server: hier false und stattdessen eigenen Prozess starten: python -m app.worker
BACKGROUND_JOBS=true

# Texterkennung (OCR) für Scans und Fotos: Pfad zu tesseract.exe. Leer lassen = automatisch
# suchen (PATH und C:\Program Files\Tesseract-OCR). Ohne Tesseract werden Scans von Hand erfasst.
TESSERACT_CMD=

# System-Mails (Login-Code, Einladung). Leer lassen = lokal werden die Mails als
# .eml-Datei unter data/mail_ausgang/ abgelegt und der Code im Konsolenfenster angezeigt.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true
