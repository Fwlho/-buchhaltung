# Vorlage für die .env auf dem SERVER (Docker). Kopieren:  cp .env.server.example .env
# Danach die Schlüssel erzeugen und anhängen:            python3 deploy/neue-schluessel.py >> .env
# Die .env niemals weitergeben – ohne sie lassen sich gespeicherte Passwörter nicht entschlüsseln.

# Ihre Domain (muss per DNS auf diesen Server zeigen), z. B. buchhaltung.example.de
DOMAIN=

# System-Mails (Login-Codes, Einladungen) – auf dem Server nötig, sonst kann sich niemand anmelden
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=true

# Pflichtangaben im Internet (§ 5 DDG, Art. 13 DSGVO): Links auf Impressum und Datenschutzerklärung des Betreibers
# (vollständige https-Adressen); erscheinen auf der Anmeldeseite und unten auf jeder Seite
IMPRESSUM_URL=
DATENSCHUTZ_URL=

# Verschlüsselte Sicherung (deploy/sicherung.sh, Einrichtung siehe BETRIEB.md „Datensicherung (Server)“)
# Öffentlicher age-Schlüssel (age1…) – den privaten Schlüssel hat nur der Inhaber, nie auf dem Server lassen
BACKUP_AGE_EMPFAENGER=
# Storage Box an einem anderen Standort, z. B. u123456@u123456.your-storagebox.de
BACKUP_ZIEL_SSH=
BACKUP_ZIEL_ORDNER=buchhaltung
BACKUP_TAGE=30

# Die folgenden Werte schreibt deploy/neue-schluessel.py:
# SECRET_KEY, ENCRYPTION_KEY, POSTGRES_PASSWORD, SETUP_TOKEN
